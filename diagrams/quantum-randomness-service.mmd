%% is_derived_view=true
%% Traceability.parent: diagrams/quantum-architecture.mmd
%% Scope: authenticated Fly.io API and worker-owned verified cache publication
graph TB
    Client[Authenticated client<br/>Authorization: Bearer token]:::state

    subgraph Machine["One Fly.io machine · quantum-randomness · one mounted volume"]
        Gunicorn[Gunicorn<br/>0.0.0.0:8211]:::quantum
        Flask[quantum_randomness_service.app:create_app<br/>/v1 bytes · bits · ints · bool]:::quantum
        Auth[Constant-time bearer auth<br/>rate limits and request bounds]:::state
        Refresh[Refresh worker-published manifest<br/>verify HMAC-SHA256 signature]:::quantum
        Worker[Refill worker sibling process<br/>machine supervisor]:::quantum
        subgraph Volume["Persistent volume · quantum_randomness_data mounted at /data"]
            Retained[Atomically retained local<br/>verified-generation.json]:::db
            Consumption[consumption.sqlite3<br/>shared reservation ledger]:::db
        end
        APIStatus[Public status<br/>current · stale · unavailable]:::state
        Schedule[Monthly policy schedule<br/>day 1 · 07:00 UTC]:::state
        Refill[Threshold-gated refill<br/>remaining bits <= 25 percent]:::quantum
        IBM{{IBM Quantum provider<br/>measured Hadamard bits}}:::ext
        Sign[Build signed generation<br/>HMAC-SHA256 manifest]:::quantum
        Publish[Pending object then atomic promotion<br/>verified/generation.json]:::quantum
    end

    Tigris{{Fly Tigris S3-compatible storage<br/>quantum-randomness-cache}}:::ext
    Quantum[Verified quantum source<br/>current generation with sufficient bits]:::quantum
    Stale[Stale verified generation<br/>older than 30 days]:::state
    Unavailable[Unavailable or invalid cache]:::state
    CSPRNG[OS CSPRNG<br/>secrets.token_bytes]:::ext
    Provenance[Response provenance<br/>source + quantum_cache state]:::state

    Client --> Gunicorn
    Gunicorn --> Flask
    Flask --> Auth
    Auth --> Refresh
    Refresh --> Tigris
    Refresh --> Retained
    Flask --> Consumption
    Consumption -.->|"BEGIN IMMEDIATE reserves unique byte ranges"| Flask
    Retained --> APIStatus
    Flask --> APIStatus
    Refresh --> Quantum
    Refresh --> Stale
    Refresh --> Unavailable
    Quantum --> Provenance
    Stale --> Provenance
    Unavailable --> Provenance
    Quantum --> Flask
    Stale --> CSPRNG
    Unavailable --> CSPRNG
    CSPRNG --> Provenance
    Provenance --> Flask
    Schedule --> Refill
    Refill --> IBM
    IBM --> Sign
    Sign ==> Publish
    Publish --> Tigris
    Publish --> Retained
    Worker -.->|"same process boundary; reads the same consumption.sqlite3"| Consumption
    Worker -.->|"API child receives no IBM/Tigris credentials"| Gunicorn
    Retained -.->|"previous verified generation remains on fetch or publish failure"| Refresh

